# Copy to .env and fill in. Never commit .env.

# --- Server-side (API / worker): ONE shared WattTime credential ---
WATTTIME_USERNAME=
WATTTIME_PASSWORD=

# --- Client-side (CLI): point at API instead of personal WattTime keys ---
# CARBONSIGHT_API_URL=http://localhost:8001

# Optional
CARBON_PROVIDER=watttime
LOG_LEVEL=INFO
CACHE_TOKENS=true
REQUEST_TIMEOUT=15
CACHE_TTL_SECONDS=900
CARBON_PRICE_USD_PER_TON=50

# Worker / DB
# DATABASE_URL=postgresql://carbonsight:carbonsight@localhost:5432/carbonsight
# WORKER_INTERVAL_SECONDS=900
# GRID_SIGNAL_RETENTION_HOURS=168
