# Copy to .env and fill in. Never commit .env.

# Direct CLI mode (use both) or central server worker credentials.
WATTTIME_USERNAME=
WATTTIME_PASSWORD=

# Credentialless CLI mode: point at the centrally hosted CarbonSight API.
CARBONSIGHT_API_URL=

# Explicitly opt into non-physical synthetic data for local demos only.
CARBONSIGHT_DEMO_MODE=0

# Required by docker-compose because Postgres is exposed on localhost.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
