# Copy to .env and fill in. Never commit .env.

# --- Pick ONE of the two modes below ---------------------------------------

# Mode A: bring your own key. Each user has their own WattTime account.
#   https://www.watttime.org/
WATTTIME_USERNAME=
WATTTIME_PASSWORD=

# Mode B: central credential. ONE login lives on the server (see
# infra/docker/docker-compose.yml); the worker refreshes the cache and clients
# read through the API with no credentials of their own.
#   CARBONSIGHT_API_URL=http://localhost:8000
CARBONSIGHT_API_URL=

# With neither set, the CLI refuses to rank rather than inventing numbers.
# Synthetic MOER exists for offline demos and is a hash of the region name --
# it is not physically meaningful and is never used as a fallback.

# --- Server side (worker + API) ---------------------------------------------
# Under docker-compose these three build DATABASE_URL for you. User and database
# default to "carbonsight"; the password has no default and compose will refuse
# to start without it, because it publishes port 5432 to the host.
# POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_DB=
#
# Set DATABASE_URL directly when you are not using compose.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carbonsight
# WORKER_INTERVAL_SECONDS=900          # how often the worker refreshes
# GRID_SIGNAL_RETENTION_HOURS=168      # how long forecast rows are kept
# CARBONSIGHT_FORECAST_CACHE_TTL=900   # in-process forecast cache TTL

# --- AWS (optional, for live pricing and launch preflight) -------------------
# Install with the [aws] extra. Without boto3 these features switch off cleanly.
# CARBONSIGHT_LIVE_AWS_PRICING=false
# CARBONSIGHT_PRICING_CACHE_TTL=3600
# AWS_PROFILE=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
CACHE_TOKENS=true
REQUEST_TIMEOUT=15
